<Project>

  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT / Trimming -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>

    <!-- Warnings -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest-all</AnalysisLevel>

    <!-- Package metadata shared across all packages -->
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Product>EricksonLopez.Specification</Product>
    <Copyright>Copyright © Erickson Lopez. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ericksonlopez.dev/dotnet-specification</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-specification</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <CommonPackageTags>dotnet;csharp;specification;specification-pattern;ddd;clean-architecture</CommonPackageTags>
    <PublishRepositoryUrl Condition="'$(CI)' == 'true'">true</PublishRepositoryUrl>
    <PublishRepositoryUrl Condition="'$(CI)' != 'true'">false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries Condition="'$(CI)' != 'true'">false</EnableSourceControlManagerQueries>
    <EnableSourceLink Condition="'$(CI)' != 'true'">false</EnableSourceLink>
    <SourceLinkCreate Condition="'$(CI)' != 'true'">false</SourceLinkCreate>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Strong Naming -->
    <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)EricksonLopez.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)EricksonLopez.snk')">$(MSBuildThisFileDirectory)EricksonLopez.snk</AssemblyOriginatorKeyFile>
    <PublicKey Condition="'$(SignAssembly)' == 'true'"></PublicKey>
    <DefineConstants Condition="'$(SignAssembly)' == 'true'">$(DefineConstants);SIGN_ASSEMBLY</DefineConstants>
    <GenerateDocumentationFile Condition="!$(MSBuildProjectDirectory.Contains('tests')) and !$(MSBuildProjectDirectory.Contains('benchmarks')) and !$(MSBuildProjectDirectory.Contains('samples'))">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS0016;RS0017;RS0037;CA1805;CA1711;CA1000;CA1716;CA1834;CS1061</NoWarn>

    <!-- Version -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageVersion>$(VersionPrefix)</PackageVersion>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(SignAssembly)' == 'true'">
    <InternalsVisibleTo>
      <Key>$(PublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>

  <!-- Test and Benchmark configuration -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.IntegrationTests')) or $(MSBuildProjectName.EndsWith('.Benchmarks')) or $(MSBuildProjectName.EndsWith('.AotSmokeTest'))">
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- SonarQube project categorization -->
    <SonarQubeTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.IntegrationTests'))">true</SonarQubeTestProject>
    <SonarQubeExclude Condition="$(MSBuildProjectName.EndsWith('.Benchmarks')) or $(MSBuildProjectName.EndsWith('.AotSmokeTest'))">true</SonarQubeExclude>
    <!-- Suppress non-actionable code style/naming warnings in test suites per ADR-026 (Osherove naming) and test framework dynamics -->
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8604;IDE1006;CA1707;CA1515;CA1822;CA2007;CA1815;CA2201;CA1305;CA1852;CA1861;CA1862;CA1866;CA1002;CA1034;CA2225;CA2227;CA1304;NU1608;NU1903;IL2026;IL2055;IL2060;IL2072;IL2073;IL2093;xUnit1030;xUnit1031</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- Sample configuration -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
    <IsPackable>false</IsPackable>
    <SonarQubeExclude>true</SonarQubeExclude>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <!-- Configuration for Analyzers/Generators (build-time tooling) -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Analyzers')) or $(MSBuildProjectName.EndsWith('.Generators'))">
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);RS2008;CA1062</NoWarn>
  </PropertyGroup>

  <!-- Packaging files (icon and README) for packable projects -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' and !$(MSBuildProjectName.EndsWith('.Tests')) and !$(MSBuildProjectName.EndsWith('.IntegrationTests')) and !$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>
</Project>




