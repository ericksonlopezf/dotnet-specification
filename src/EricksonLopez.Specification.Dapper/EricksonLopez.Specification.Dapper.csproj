<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EricksonLopez.Specification.Dapper</AssemblyName>
    <RootNamespace>EricksonLopez.Specification.Dapper</RootNamespace>
    <PackageId>EricksonLopez.Specification.Dapper</PackageId>
    <Description>Dapper integration for EricksonLopez.Specification. Execute QuerySpec&lt;T&gt; against IDbConnection using parameterized SQL generated by the SQL translation layer.</Description>
    <PackageTags>$(CommonPackageTags);dapper;micro-orm;repository-pattern;data-access;sql</PackageTags>
    <!-- Dapper uses some reflection internally; mark as not fully AOT compatible -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Class1.cs" />
    <ProjectReference Include="..\EricksonLopez.Specification.Sql\EricksonLopez.Specification.Sql.csproj" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

</Project>
